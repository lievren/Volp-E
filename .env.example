# Optional desktop brain URL used by the Raspberry Pi service.
# Copy to /etc/default/volp-e on the Pi and replace YOUR_PC_IP.
VOLPE_EXTERNAL_BRAIN_URL=http://YOUR_PC_IP:8787

# Optional user override for scripts that need the Pi username.
VOLPE_USER=pi

# Optional SVG source path for tools/build_face.py.
VOLPE_SOURCE_SVG=assets/face.svg
